# 선택 사항: GitHub API 요청 한도(인증 없이 시간당 60회)가 부족할 때만 서버 전용 토큰을 넣는다.
# 공개 저장소 읽기만 필요하므로 권한이 없는 토큰이면 충분하다. 실제 값은 .env.local 또는 Vercel 환경 변수에만 둔다.
GITHUB_TOKEN=

# 요구사항 추출(OpenAI). 서버 전용이며 브라우저로 노출하지 않는다. 실제 값은 .env.local 또는 Vercel 환경 변수에만 둔다.
OPENAI_API_KEY=
# 선택 사항. 비우면 gpt-5-mini를 쓴다.
OPENAI_MODEL=

# Supabase (Auth·분석 기록 저장 준비). 둘 다 브라우저에 노출되는 공개 값이다. service_role / secret 키는 절대 넣지 않는다.
# 비워 두면 Supabase 없이 기존 비로그인 분석만 동작한다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
